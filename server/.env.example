# MongoDB connection string (get from MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/warehouse?retryWrites=true&w=majority

# Server port (Render uses 10000, local dev uses 5000)
PORT=5000

# Frontend URL for CORS (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
